# Required in production (generate with: openssl rand -base64 32)
AUTH_SECRET=

# Demo user for the credentials provider (override in dev/staging as needed)
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=demo

# Legacy aliases (optional) — prefer DEMO_USER_* above
# AUTH_DEMO_EMAIL=
# AUTH_DEMO_PASSWORD=

# Public URL of the app (optional; inferred in many deployments)
# AUTH_URL=http://localhost:3000
